# Public production URL used for canonical URLs, sitemap and social metadata.
# Replace this with the final domain before launch.
NEXT_PUBLIC_SITE_URL=https://freelen.studio

# Contact form delivery. Create a Resend API key at https://resend.com/api-keys
# without it the form returns a clear "not configured" state instead of a false
# success. Enquiries are delivered to CONTACT_TO_EMAIL and the customer receives
# an automatic thank-you email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=sainiaakash871@gmail.com
# onboarding@resend.dev only delivers to the Resend account owner. Verify your
# domain at https://resend.com/domains and use an address on it before launch so
# customer confirmation emails can be delivered.
RESEND_FROM_EMAIL=Freelen Studio <onboarding@resend.dev>
