# Public production URL used for canonical URLs, sitemap and social metadata.
# Replace this with the final domain before launch.
NEXT_PUBLIC_SITE_URL=https://freelen.studio

# Search engine verification (paste only the content value from the meta tag).
# Google Search Console → Settings → Ownership verification → HTML tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag (msvalidate.01 value).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Contact form delivery. Gmail SMTP is used when both Gmail values are present.
# Enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16-character value.
GMAIL_USER=sainiaakash871@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=sainiaakash871@gmail.com

# Optional fallback used only when the Gmail values are not set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Freelen Studio <onboarding@resend.dev>
